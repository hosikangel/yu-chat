# ============================================================
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 입력하세요.
# .env.local 은 절대 GitHub 에 올리지 마세요!
# Vercel 에는 대시보드 → Settings → Environment Variables 에 입력
# ============================================================

# 서버 전용 (클라이언트에 노출 안 됨)
DEEPL_API_KEY=여기에_DeepL_키_입력
GOOGLE_STT_API_KEY=여기에_Google_키_입력
AZURE_TTS_KEY=여기에_Azure_키_입력
AZURE_TTS_REGION=koreacentral
ELEVENLABS_API_KEY=여기에_ElevenLabs_키_입력
JWT_SECRET=최소32자이상의랜덤문자열입력

# 클라이언트에 공개되는 값 (NEXT_PUBLIC_ 접두사)
NEXT_PUBLIC_SIGNALING_URL=wss://여기에_Railway_서버_주소
NEXT_PUBLIC_APP_NAME=LinguaTalk
